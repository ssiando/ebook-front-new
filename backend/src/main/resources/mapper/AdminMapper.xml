<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mict.ebook.admin.repository.mapper.AdminMapper">

    <resultMap id="adminResultMap" type="com.mict.ebook.admin.domain.Admin">
        <id property="id" column="id" />
        <result property="loginId" column="login_id" />
        <result property="adminName" column="admin_nm" />
        <result property="email" column="admin_email" />
        <result property="passwordHash" column="admin_pwd" />
        <result property="department" column="department" />
        <result property="failCount" column="fail_fcnt" />
        <result property="registrantId" column="regr_id" />
        <result property="updaterId" column="updr_id" />
        <result property="activeYn" column="active_yn" />
        <result property="status" column="status" />
        <result property="serviceExpiresAt" column="service_expires_at" />
        <result property="lastLoginAt" column="last_login_dtm" />
        <result property="lastLoginIp" column="last_login_ip" />
        <result property="createdAt" column="reg_dtm" />
        <result property="updatedAt" column="upd_dtm" />
    </resultMap>

    <sql id="adminColumns">
        id, login_id, admin_nm, admin_email, admin_pwd, department, fail_fcnt, regr_id, updr_id, active_yn,
        status, service_expires_at, last_login_dtm, last_login_ip, reg_dtm, upd_dtm
    </sql>

    <select id="findByEmail" resultMap="adminResultMap">
        SELECT <include refid="adminColumns" />
        FROM cm_admin_bas
        WHERE admin_email = #{email}
    </select>

    <select id="findRoleNamesByAdminId" resultType="string">
        SELECT DISTINCT r.role_nm
        FROM cm_admin_role ar
        JOIN cm_role_bas r ON r.id = ar.role_id
        WHERE ar.admin_id = #{adminId}
        AND r.active_yn = 1
    </select>

    <sql id="searchCondition">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (admin_nm LIKE CONCAT('%', #{keyword}, '%')
                OR admin_email LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="department != null and department != ''">
                AND department = #{department}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="search" resultMap="adminResultMap">
        SELECT <include refid="adminColumns" />
        FROM cm_admin_bas
        <include refid="searchCondition" />
        ORDER BY id DESC
    </select>

    <select id="findById" resultMap="adminResultMap">
        SELECT <include refid="adminColumns" />
        FROM cm_admin_bas
        WHERE id = #{id}
    </select>

    <select id="existsByEmail" resultType="boolean">
        SELECT EXISTS(
        SELECT 1 FROM cm_admin_bas
        WHERE admin_email = #{email}
        )
    </select>

    <select id="existsByEmailExcludingId" resultType="boolean">
        SELECT EXISTS(
        SELECT 1 FROM cm_admin_bas
        WHERE admin_email = #{email}
        AND id != #{id}
        )
    </select>

    <select id="existsByLoginId" resultType="boolean">
        SELECT EXISTS(
        SELECT 1 FROM cm_admin_bas
        WHERE login_id = #{loginId}
        )
    </select>

    <select id="existsByLoginIdExcludingId" resultType="boolean">
        SELECT EXISTS(
        SELECT 1 FROM cm_admin_bas
        WHERE login_id = #{loginId}
        AND id != #{id}
        )
    </select>

    <insert id="insert" parameterType="com.mict.ebook.admin.domain.Admin" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cm_admin_bas
            (login_id, admin_nm, admin_email, admin_pwd, department, fail_fcnt, active_yn, status, regr_id, updr_id)
        VALUES
            (#{loginId}, #{adminName}, #{email}, #{passwordHash}, #{department}, #{failCount}, #{activeYn}, #{status},
             #{registrantId}, #{updaterId})
    </insert>

    <update id="update" parameterType="com.mict.ebook.admin.domain.Admin">
        UPDATE cm_admin_bas
        SET admin_nm           = #{adminName},
            admin_email        = #{email},
            department         = #{department},
            active_yn          = #{activeYn},
            status             = #{status},
            service_expires_at = #{serviceExpiresAt},
            updr_id            = #{updaterId}
        WHERE id = #{id}
    </update>

    <update id="recordLoginSuccess">
        UPDATE cm_admin_bas
        SET fail_fcnt      = 0,
            last_login_dtm = #{lastLoginAt},
            last_login_ip  = #{lastLoginIp}
        WHERE id = #{id}
    </update>

    <update id="recordLoginFailure">
        UPDATE cm_admin_bas
        SET fail_fcnt = fail_fcnt + 1
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE
        FROM cm_admin_bas
        WHERE id = #{id}
    </delete>

    <select id="findRoleIdsByAdminId" resultType="long">
        SELECT role_id
        FROM cm_admin_role
        WHERE admin_id = #{adminId}
    </select>

    <delete id="deleteAdminRoles">
        DELETE
        FROM cm_admin_role
        WHERE admin_id = #{adminId}
    </delete>

    <insert id="insertAdminRoles">
        INSERT INTO cm_admin_role (admin_id, role_id)
        VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{adminId}, #{roleId})
        </foreach>
    </insert>

    <select id="findGroupCodesByAdminId" resultType="string">
        SELECT group_code
        FROM cm_admin_group
        WHERE admin_id = #{adminId}
    </select>

    <delete id="deleteAdminGroups">
        DELETE
        FROM cm_admin_group
        WHERE admin_id = #{adminId}
    </delete>

    <insert id="insertAdminGroups">
        INSERT INTO cm_admin_group (admin_id, group_code)
        VALUES
        <foreach collection="groupCodes" item="groupCode" separator=",">
            (#{adminId}, #{groupCode})
        </foreach>
    </insert>

</mapper>
