<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mict.ebook.admin.repository.mapper.AdminMapper">

    <resultMap id="adminResultMap" type="com.mict.ebook.admin.domain.Admin">
        <id property="id" column="id" />
        <result property="adminId" column="admin_id" />
        <result property="adminName" column="admin_name" />
        <result property="email" column="email" />
        <result property="passwordHash" column="password_hash" />
        <result property="department" column="department" />
        <result property="status" column="status" />
        <result property="registrant" column="registrant" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <select id="findByAccount" resultMap="adminResultMap">
        SELECT id, admin_id, admin_name, email, password_hash, department, status, registrant, created_at, updated_at
        FROM admin
        WHERE admin_id = #{account}
        OR email = #{account}
    </select>

    <select id="findRoleNamesByAdminId" resultType="string">
        SELECT DISTINCT r.role_name
        FROM admin_role ar
        JOIN role r ON r.id = ar.role_id
        WHERE ar.admin_id = #{adminId}
    </select>

</mapper>
