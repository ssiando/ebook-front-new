<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mict.ebook.workspace.repository.mapper.WorkspaceMapper">

    <resultMap id="workspaceResultMap" type="com.mict.ebook.workspace.domain.Workspace">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="stat" column="stat" />
        <result property="description" column="descp" />
        <result property="createdAt" column="reg_dtm" />
        <result property="updatedAt" column="upd_dtm" />
    </resultMap>

    <select id="findAll" resultMap="workspaceResultMap">
        SELECT id, name, stat, descp, reg_dtm, upd_dtm
        FROM cm_workspace_bas
        ORDER BY id ASC
    </select>

</mapper>
