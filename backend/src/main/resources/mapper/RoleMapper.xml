<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mict.ebook.role.repository.mapper.RoleMapper">

    <resultMap id="roleResultMap" type="com.mict.ebook.role.domain.Role">
        <id property="id" column="id" />
        <result property="workspaceId" column="workspace_id" />
        <result property="roleName" column="role_nm" />
        <result property="description" column="descp" />
        <result property="activeYn" column="active_yn" />
        <result property="registrantId" column="regr_id" />
        <result property="updaterId" column="updr_id" />
        <result property="createdAt" column="reg_dtm" />
        <result property="updatedAt" column="upd_dtm" />
    </resultMap>

    <sql id="roleColumns">
        id, workspace_id, role_nm, descp, active_yn, regr_id, updr_id, reg_dtm, upd_dtm
    </sql>

    <sql id="searchCondition">
        <where>
            AND workspace_id = #{workspaceId}
            <if test="keyword != null and keyword != ''">
                AND (role_nm LIKE CONCAT('%', #{keyword}, '%')
                OR descp LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </sql>

    <select id="search" resultMap="roleResultMap">
        SELECT <include refid="roleColumns" />
        FROM cm_role_bas
        <include refid="searchCondition" />
        ORDER BY id DESC
    </select>

    <select id="findById" resultMap="roleResultMap">
        SELECT <include refid="roleColumns" />
        FROM cm_role_bas
        WHERE id = #{id}
    </select>

    <select id="existsByWorkspaceIdAndRoleName" resultType="boolean">
        SELECT EXISTS(
        SELECT 1 FROM cm_role_bas
        WHERE workspace_id = #{workspaceId}
        AND role_nm = #{roleName}
        AND active_yn = 1
        )
    </select>

    <select id="existsByWorkspaceIdAndRoleNameExcludingId" resultType="boolean">
        SELECT EXISTS(
        SELECT 1 FROM cm_role_bas
        WHERE workspace_id = #{workspaceId}
        AND role_nm = #{roleName}
        AND active_yn = 1
        AND id != #{id}
        )
    </select>

    <insert id="insert" parameterType="com.mict.ebook.role.domain.Role" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cm_role_bas (workspace_id, role_nm, descp, active_yn, regr_id, updr_id)
        VALUES (#{workspaceId}, #{roleName}, #{description}, #{activeYn}, #{registrantId}, #{updaterId})
    </insert>

    <update id="update" parameterType="com.mict.ebook.role.domain.Role">
        UPDATE cm_role_bas
        SET role_nm = #{roleName},
            descp   = #{description},
            updr_id = #{updaterId}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE
        FROM cm_role_bas
        WHERE id = #{id}
    </delete>

    <select id="countMembersByRoleId" resultType="long">
        SELECT COUNT(*)
        FROM cm_admin_role
        WHERE role_id = #{roleId}
    </select>

    <select id="findProgramIdsByRoleId" resultType="long">
        SELECT program_id
        FROM cm_role_program
        WHERE role_id = #{roleId}
    </select>

    <delete id="deleteRolePrograms">
        DELETE
        FROM cm_role_program
        WHERE role_id = #{roleId}
    </delete>

    <insert id="insertRolePrograms">
        INSERT INTO cm_role_program (role_id, program_id)
        VALUES
        <foreach collection="programIds" item="programId" separator=",">
            (#{roleId}, #{programId})
        </foreach>
    </insert>

</mapper>
