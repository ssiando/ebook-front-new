<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mict.ebook.role.repository.mapper.RoleMapper">

    <resultMap id="roleResultMap" type="com.mict.ebook.role.domain.Role">
        <id property="id" column="id" />
        <result property="roleName" column="role_name" />
        <result property="description" column="description" />
        <result property="system" column="system" typeHandler="com.mict.ebook.role.domain.SystemTypeHandler" />
        <result property="registrant" column="registrant" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <sql id="searchCondition">
        <where>
            <if test="system != null">
                AND r.system = #{system, typeHandler=com.mict.ebook.role.domain.SystemTypeHandler}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (r.role_name LIKE CONCAT('%', #{keyword}, '%')
                OR r.description LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </sql>

    <select id="search" resultMap="roleResultMap">
        SELECT r.id, r.role_name, r.description, r.system, r.registrant, r.created_at, r.updated_at
        FROM role r
        <include refid="searchCondition" />
        ORDER BY r.id DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="countBySearch" resultType="long">
        SELECT COUNT(*)
        FROM role r
        <include refid="searchCondition" />
    </select>

    <select id="findById" resultMap="roleResultMap">
        SELECT id, role_name, description, system, registrant, created_at, updated_at
        FROM role
        WHERE id = #{id}
    </select>

    <select id="existsByRoleNameAndSystem" resultType="boolean">
        SELECT EXISTS(
        SELECT 1 FROM role
        WHERE role_name = #{roleName}
        AND system = #{system, typeHandler=com.mict.ebook.role.domain.SystemTypeHandler}
        )
    </select>

    <insert id="insert" parameterType="com.mict.ebook.role.domain.Role" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO role (role_name, description, system, registrant)
        VALUES (#{roleName},
        #{description},
        #{system, typeHandler=com.mict.ebook.role.domain.SystemTypeHandler},
        #{registrant})
    </insert>

    <update id="update" parameterType="com.mict.ebook.role.domain.Role">
        UPDATE role
        SET role_name   = #{roleName},
            description = #{description},
            registrant  = #{registrant}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE
        FROM role
        WHERE id = #{id}
    </delete>

    <select id="countMembersByRoleId" resultType="long">
        SELECT COUNT(*)
        FROM admin_role
        WHERE role_id = #{roleId}
    </select>

    <select id="findProgramIdsByRoleId" resultType="string">
        SELECT program_id
        FROM role_program
        WHERE role_id = #{roleId}
    </select>

    <delete id="deleteRolePrograms">
        DELETE
        FROM role_program
        WHERE role_id = #{roleId}
    </delete>

    <insert id="insertRolePrograms">
        INSERT INTO role_program (role_id, program_id)
        VALUES
        <foreach collection="programIds" item="programId" separator=",">
            (#{roleId}, #{programId})
        </foreach>
    </insert>

</mapper>
